# ============================================================================
# env.example  ->  copy this file to  .env  and fill in the keys you use.
#
#   macOS / Linux:   cp env.example .env
#   Windows (cmd):   copy env.example .env
#
# Then open the new ".env" file and paste your keys after the "=" signs.
#
# IMPORTANT:
#   - You usually only need ONE LLM key (the provider you pick in config.yaml).
#   - Leave the rest blank. A blank value just means "not available".
#   - NEVER share or upload the real ".env" file. It stays on your machine.
#     (It is already listed in .gitignore so it won't be committed.)
# ============================================================================


# ----------------------------------------------------------------------------
# 1) LLM PROVIDER KEY - pick the one that matches "provider:" in config.yaml
#    (If "provider: mock", you need NO key at all - it runs offline for free.)
# ----------------------------------------------------------------------------

# provider: anthropic    -> get it at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# provider: openai       -> get it at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# provider: deepseek     -> get it at https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# provider: google       -> get it at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=


# ----------------------------------------------------------------------------
# 2) ACADEMIC DATABASE KEYS - OPTIONAL (only if your institution gives you one)
#    Leave them blank if you don't have them - the system still works.
# ----------------------------------------------------------------------------

# Scopus and ScienceDirect share the Elsevier key: https://dev.elsevier.com/
ELSEVIER_API_KEY=

# Web of Science / Clarivate: https://developer.clarivate.com/
WOS_API_KEY=


# ----------------------------------------------------------------------------
# 3) CONTACT EMAIL - OPTIONAL but recommended
#    Open databases ask for an email so they can reach you if your requests get
#    too frequent. Setting it helps you get faster, more reliable answers.
# ----------------------------------------------------------------------------
CROSSREF_MAILTO=you@example.com
OPENALEX_MAILTO=you@example.com
