# Provedor de LLM: gemini | openai | deepseek
LLM_PROVIDER=gemini

# Modelo usado para gerar as questoes
LLM_MODEL=gemini-2.5-flash

# Chave da API do provedor escolhido
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# URL base da API (obrigatorio para DeepSeek; opcional para OpenAI)
# LLM_BASE_URL=https://api.deepseek.com

# Teto de tokens de entrada por geracao de quiz
MAX_INPUT_TOKENS=12000
